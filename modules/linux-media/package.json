{
	"name": "companion-module-linux-media",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build --ignore-license-rules",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "run build && bash -c 'if command -v dbus-run-session >/dev/null 2>&1; then dbus-run-session -- node --test --test-concurrency=1 \"dist/**/*.test.js\"; else node --test --test-concurrency=1 \"dist/**/*.test.js\"; fi'"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Waayway/companion-modules.git",
		"directory": "modules/linux-media"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@particle/dbus-next": "patch:@particle/dbus-next@npm%3A0.11.4#~/.yarn/patches/@particle-dbus-next-npm-0.11.4-24d51a1af8.patch"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1",
	"private": true
}
